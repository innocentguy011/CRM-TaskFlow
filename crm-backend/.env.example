# ═══════════════════════════════════════════════════════════════════════════
# CRM Backend - environment variables
# Copy to crm-backend/.env for local use (git-ignored). Never commit real values.
# In production, set these in the hosting provider's environment settings.
# ═══════════════════════════════════════════════════════════════════════════

# Profile: dev (local, port 8081, seeds demo data) or prod (Docker / Render)
SPRING_PROFILES_ACTIVE=dev
# Port override (Render injects PORT automatically)
# SERVER_PORT=8081

# ─── PostgreSQL ────────────────────────────────────────────────────────────
# JDBC form. Neon example: jdbc:postgresql://<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/crm_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password
# DB_POOL_SIZE=5

# ─── Redis (cache + online presence) ───────────────────────────────────────
# false = in-memory cache and presence (single instance only)
REDIS_ENABLED=true
# Either a URL (Upstash: rediss://default:<password>@<host>:6379, plus REDIS_SSL=true) ...
# SPRING_DATA_REDIS_URL=
# ... or host/port/password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ─── JWT ───────────────────────────────────────────────────────────────────
# Base64 value (e.g. `openssl rand -base64 48`) or a plain string of 32+ characters
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ─── AI (any OpenAI-compatible chat completions API; Groq by default) ──────
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# ─── Frontend URL ──────────────────────────────────────────────────────────
# prod profile derives CORS, WebSocket origins, OAuth2 and invitation redirects from it
FRONTEND_URL=http://localhost:3000
# Optional explicit overrides (comma-separated; wildcards like https://*.vercel.app allowed for CORS)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Demo data ─────────────────────────────────────────────────────────────
# Seeds test1@example.com, test2@example.com, admin@example.com into an EMPTY database.
# Seeding is skipped when DEMO_SEED_PASSWORD is blank. dev profile defaults: true / password123
DEMO_SEED_ENABLED=false
DEMO_SEED_PASSWORD=

# ─── Email via Brevo HTTP API (optional: workspace invitations, reminders) ─
# Without it, invitations are still created but no email is delivered.
BREVO_API_KEY=
APP_MAIL_FROM=verified-sender@yourdomain.com
APP_MAIL_FROM_NAME=TaskFlow

# ─── OAuth2 login (optional) ───────────────────────────────────────────────
# Callback URLs to register: <backend-url>/login/oauth2/code/google and .../github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Misc ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB
