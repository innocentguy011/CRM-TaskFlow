# ═══════════════════════════════════════════════════════════════════════════
# CRM Frontend - environment variables
# Copy to crm-frontend/.env.local for local overrides (git-ignored).
# .env.development (committed) already points to http://localhost:8081.
# On Vercel, set VITE_API_URL in Project Settings → Environment Variables.
# ═══════════════════════════════════════════════════════════════════════════

# Backend base URL, without a trailing slash and without /api.
# REST calls go to ${VITE_API_URL}/api, WebSocket (SockJS) to ${VITE_API_URL}/ws,
# which upgrades to wss:// automatically when the URL is https.
VITE_API_URL=http://localhost:8081

# Optional: shown on the Google/GitHub login buttons (must match the backend's OAuth apps)
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
